# Supabase — Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# LLM providers (all free-tier)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=https://your-ai-tutor-site.com,https://your-homework-site.com

# Email notifications ("request a tutor" on the AI Tutor site).
# Using Gmail SMTP as a free option — you need an "App Password", not your
# regular Gmail password: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on the Google account first.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=binayakindu84@gmail.com
NOTIFY_EMAIL=sanjaybinayak778@gmail.com
